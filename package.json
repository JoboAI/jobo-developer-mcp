{
  "name": "jobo-developer-mcp",
  "version": "0.1.0",
  "description": "Developer MCP server for the Jobo API — look up company ids, occupations and filter values, and build a valid job-search request, from inside a coding agent.",
  "mcpName": "world.jobo/developer",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "jobo-developer-mcp": "dist/index.js"
  },
  "files": [
    "dist",
    "!dist/**/*.test.js",
    "!dist/**/*.test.d.ts",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --test dist/*.test.js"
  },
  "keywords": [
    "mcp",
    "model context protocol",
    "jobo",
    "jobs api",
    "developer tools",
    "api integration"
  ],
  "author": "Jobo <support@jobo.world>",
  "license": "MIT",
  "homepage": "https://jobo.world/docs/connectors/mcp#developer-server",
  "dependencies": {
    "@jobo-ai/connector-core": "0.5.0",
    "@modelcontextprotocol/node": "^2.0.0",
    "@modelcontextprotocol/server": "^2.0.0",
    "express": "^4.18.2",
    "zod": "^4.2.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.10.0",
    "tsx": "^4.6.2",
    "typescript": "^5.3.2"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
